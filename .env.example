# ============================================================
# CẤU HÌNH MÔI TRƯỜNG TRIỂN KHAI (TECHSTORE / PRODUCTION DEPLOY)
# ============================================================

# Cổng chạy ứng dụng (Mặc định 3000 khi chạy standalone / VPS / Render / Railway)
PORT=3000

# Môi trường chạy ('production' hoặc 'development')
NODE_ENV=production

# Khóa bí mật mã hóa Session người dùng
SESSION_SECRET=phone_store_ultra_secure_session_key_2026

# ============================================================
# CƠ SỞ DỮ LIỆU NEON POSTGRESQL (Tùy chọn nhưng khuyến nghị cho deploy)
# ============================================================
# Tạo database PostgreSQL serverless miễn phí tại: https://console.neon.tech
# Nếu để trống, ứng dụng tự động chạy chế độ JSON DB cục bộ / tmp.
#
# Ví dụ:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-cloud-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ============================================================
# GOOGLE GEMINI AI API KEY (Tự động hoá tư vấn & bóc tách thông số)
# ============================================================
# Lấy API Key miễn phí tại Google AI Studio: https://aistudio.google.com/app/apikey
# Nếu chưa có API key, hệ thống tự động kích hoạt Graceful Fallback không bao giờ lỗi.
GEMINI_API_KEY=
